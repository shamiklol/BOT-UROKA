# Обязательно: токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID. Оставьте пустым при первом запуске — бот сам пришлёт его в ответ на /start
OWNER_ID=
# На Railway: ссылка на базу из сервиса PostgreSQL (${{Postgres.DATABASE_URL}}).
# Локально можно оставить SQLite:
DATABASE_URL=sqlite+aiosqlite:///bot.db
TZ=Asia/Tashkent

# Необязательно: ИИ-разбор сложных фраз (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Необязательно: голосовые сообщения (OpenAI Whisper)
OPENAI_API_KEY=
